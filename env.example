# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# Email address that receives contact-form messages
OWNER_EMAIL=jsbbzbnx@gmail.com

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=https://lihaz.me,http://localhost:5500,http://127.0.0.1:5500

# SMTP settings — Gmail example below (use an App Password, see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
